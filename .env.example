# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (можно несколько через запятую; если не знаете — оставьте пустым, запустите бота и напишите ему /start)
OWNER_ID=

# Необязательно: для официального маркета Telegram и MRKT.
# Получить на https://my.telegram.org → API development tools, затем один раз: python login.py
API_ID=
API_HASH=

# Необязательно: ключ GetGems Public API
GETGEMS_API_KEY=

# Необязательно: токен MarketApp (https://marketapp.org/api-token) — лоты и реальные продажи
# в блокчейне (Fragment, GetGems, MarketApp) с моделью, фоном и символом
MARKETAPP_API_TOKEN=

# Курс для фильтра по цене лотов, выставленных только за звёзды (звёзд за 1 TON)
STARS_PER_TON=200

# Мини-приложение: https-адрес вашего сервера (см. README → «Мини-приложение»)
WEBAPP_URL=
WEBAPP_PORT=8080
# Постоянный адрес мини-приложения через ngrok (бесплатно): токен и домен из личного кабинета ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Анализ перепродажи: комиссия продавца на площадках (%) и стоимость перевода подарка между площадками (TON)
SELL_FEES=portals:5,tonnel:6,fragment:5,mrkt:5,getgems:5,marketapp:5,telegram:20
TRANSFER_COST_TON=0.15
